# Pocketly - configurazione
# Copia questo file in .env e genera i segreti con:  node scripts/init-env.mjs

# --- Database -------------------------------------------------------------
POSTGRES_USER=pocketly
POSTGRES_PASSWORD=cambiami
POSTGRES_DB=pocketly
# Porta esposta sull'host: cambiala se 5432 e occupata da un altro Postgres
POSTGRES_PORT=5432
# Usata dall'app. Con docker compose l'host e "db"; in sviluppo locale "localhost".
DATABASE_URL=postgres://pocketly:cambiami@localhost:5432/pocketly

# --- Applicazione ---------------------------------------------------------
# Porta del frontend sull'host.
APP_PORT=3000
# Porta e indirizzo dell'API in sviluppo locale (in Docker resta interna).
API_PORT=4000
API_URL=http://127.0.0.1:4000
# App web su altre origini che chiamano l'API dal browser, separate da virgola.
# Le app native e gli script non ne hanno bisogno.
API_CORS_ORIGINS=
# Proxy di cui l'API si fida per l'indirizzo del client (x-forwarded-for):
# il frontend e un eventuale reverse proxy. Formato di Express "trust proxy".
API_TRUSTED_PROXIES=loopback, uniquelocal
# URL pubblico da cui si raggiunge l'app: deve combaciare con il browser,
# altrimenti i cookie di sessione e le passkey non funzionano.
BETTER_AUTH_URL=http://localhost:3000
# Segreto per firmare i cookie di sessione. 32+ byte casuali.
BETTER_AUTH_SECRET=
# Chiave AES-256-GCM (32 byte in base64) per cifrare i segreti a riposo.
# Perdendola si perdono i dati cifrati: salvala insieme ai backup.
ENCRYPTION_KEY=

# --- Comportamento --------------------------------------------------------
# self = self-hosted, cloud = edizione gestita (fase 4)
EDITION=self
# Lingua predefinita: it | en
DEFAULT_LOCALE=it
# Chi puo registrarsi: invite = solo primo utente e inviti | open = chiunque
SIGNUP=invite
# Fuso orario usato dai job pianificati
TZ=Europe/Rome

# --- Test ------------------------------------------------------------------
# Database separato per i test end-to-end: viene creato e azzerato a ogni giro.
E2E_DATABASE_URL=postgres://pocketly:cambiami@localhost:5432/pocketly_e2e
