{
  "name": "@pocketly/api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "API REST di Pocketly (NestJS): dominio, dati, autenticazione e job",
  "type": "module",
  "scripts": {
    "dev": "tsup --watch --onSuccess \"node --env-file-if-exists=../../.env dist/main.js\"",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --experimental-strip-types src/db/migrate.mts",
    "db:studio": "drizzle-kit studio"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/node": "^24.10.1",
    "drizzle-kit": "0.31.11",
    "tsup": "8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.7",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@node-rs/argon2": "^2.0.2",
    "@pocketly/domain": "*",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "express": "5.2.1",
    "pg-boss": "12.38.0",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  }
}
