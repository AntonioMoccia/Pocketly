{
  "name": "pocketly",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Budget multi-conto: ogni euro riceve una destinazione",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "node scripts/serve-standalone.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types src/db/migrate.mts",
    "db:studio": "drizzle-kit studio",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --env-file-if-exists=.env scripts/ensure-e2e-db.mjs && playwright test",
    "setup": "node scripts/init-env.mjs",
    "db:seed": "node --env-file-if-exists=.env --experimental-strip-types scripts/seed.mts",
    "start:next": "next start"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.7",
    "@node-rs/argon2": "^2.0.2",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^0.552.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "pg-boss": "12.38.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.1",
    "typescript": "^5.9.3",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.18": true,
    "@parcel/watcher@2.6.0": true
  }
}
