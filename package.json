{
  "name": "pocketly",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Budget multi-conto: ogni euro riceve una destinazione",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @pocketly/api && npm run build -w @pocketly/web",
    "start:api": "npm run start -w @pocketly/api",
    "start:web": "npm run start -w @pocketly/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @pocketly/domain",
    "test:e2e": "node --env-file-if-exists=.env scripts/ensure-e2e-db.mjs && npm run test:e2e -w @pocketly/web",
    "db:generate": "npm run db:generate -w @pocketly/api",
    "db:migrate": "npm run db:migrate -w @pocketly/api",
    "db:studio": "npm run db:studio -w @pocketly/api",
    "setup": "node scripts/init-env.mjs"
  },
  "devDependencies": {
    "postgres": "3.4.9"
  },
  "overrides": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.18": true,
    "@parcel/watcher@2.6.0": true
  }
}
